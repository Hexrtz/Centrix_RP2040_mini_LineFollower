/*
 * ============================================================================
 *  Centrix_LineFollower_Normal - 05_SimplePD
 *  ตัวอย่างการเดินตามเส้นด้วย PD Controller แบบเข้าใจง่ายที่สุด
 * ============================================================================
 */
#include <Centrix_LineFollower_Normal.h>

// ----------------------------------------------------------------------------
// การตั้งค่าความเร็วและค่าคงที่ PD:
//   SPEED : ความเร็วฐาน 0..100%
//   Kp    : ควบคุมแรงเลี้ยวตามค่า Error ยิ่งเยอะยิ่งเลี้ยวไว (แนะนำ 1.0 - 2.0)
//   Kd    : แรงหน่วงลดการส่าย ยิ่งเยอะยิ่งนิ่ง (แนะนำประมาณ 10 ถึง 20 เท่าของ Kp)
// ----------------------------------------------------------------------------
float SPEED = 60.0;
float KP    = 1.3;
float KD    = 16.0;

void setup() {
  initRobot();       // เริ่มต้นระบบและโหลดค่าแสงจาก EEPROM
  waitForStart();    // แสดงไฟ Rainbow + รอให้กดปุ่ม SW2 เพื่อออกตัว (หรือกด SW1 Calibrate)
  LedGreen();
}

void loop() {
  // ฟังก์ชัน PD(speed, Kp, Kd) จะทำงาน 1 สเต็ปที่ความถี่คงที่ 1 kHz (1000 รอบ/วินาที)
  // หากหลุดเส้น หุ่นยนต์จะจำทิศทางล่าสุด (lastPosition) แล้วหมุนตัวกลับเข้าหาเส้นอัตโนมัติ
  // กดปุ่ม SW1 หรือ SW2 ขณะวิ่ง เพื่อหยุดฉุกเฉิน (Emergency Stop)
  PD(SPEED, KP, KD);
}
