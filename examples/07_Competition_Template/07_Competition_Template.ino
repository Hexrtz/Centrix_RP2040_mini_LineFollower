/*
 * ============================================================================
 *  Centrix_LineFollower_Normal - 07_Competition_Template
 *  เทมเพลตสำหรับลงสนามแข่งขันจริง (พร้อมค่า Config, เซนเซอร์, และรูปแบบ PD หลากหลาย)
 *
 *  คำแนะนำการใช้งาน:
 *    - คำสั่งไหนจะใช้ในการแข่งให้เปิดไว้ คำสั่งไหนไม่ใช้ให้ใส่ // คอมเมนต์ปิดไว้
 *    - เมื่อจบภารกิจใน setup() หุ่นยนต์จะมาเบรกหยุดนิ่งที่ Stop(); ใน loop() เสมอ
 * ============================================================================
 */
#include <Centrix_LineFollower_Normal.h>

void setup() {
  // ==========================================================================
  // 1. ตั้งค่า PIN เซนเซอร์และมอเตอร์ (หากต่อขาต่างจากค่าเริ่มต้น)
  //    ค่าเริ่มต้น: SIG=26(A0), S0=11, S1=10, S2=9, S3=8
  // ==========================================================================
  setSensorPins(26, 11, 10, 9, 8);  // (SIG, S0, S1, S2, S3)
  
  // (กรณีต้องการเปลี่ยนขามอเตอร์ ซ้าย/ขวา)
  // setMotorPins(0, 1, 2, 3);      // (M1_IN1, M1_IN2, M2_IN1, M2_IN2)

  // ==========================================================================
  // 2. ปรับแต่งค่าพารามิเตอร์หุ่นยนต์สำหรับสนามแข่ง (CONFIG)
  // ==========================================================================
  LINE_IS_BLACK    = true;   // true = เส้นดำพื้นขาว | false = เส้นขาวพื้นดำ
  SENSOR_REVERSE   = false;  // true = สลับด้านเซนเซอร์ ซ้าย-ขวา
  LEFT_INVERT      = false;  // true = กลับทิศทางมอเตอร์ซ้าย
  RIGHT_INVERT     = false;  // true = กลับทิศทางมอเตอร์ขวา

  // ค่าการเลี้ยว 90 องศา และการข้ามแยก
  TURN_SPEED       = 50;     // ความเร็วในการหมุนเลี้ยว (%)
  CROSS_FORWARD_MS = 120;    // ระยะเวลาเดินหน้าเล็กน้อยเพื่อให้ล้อตรงกับแยกก่อนเลี้ยว (ms)
  CROSS_PASS_MS    = 180;    // ระยะเวลาเดินหน้าข้ามเส้นตัดสำหรับ action 'p' (ms)

  // ==========================================================================
  // 3. เริ่มต้นระบบ (INITIALIZATION)
  // ==========================================================================
  initRobot();  // ตั้งค่า Pin, PWM 20kHz, ADC 12-bit และโหลดค่า Calibrate จาก EEPROM

  // ==========================================================================
  // 4. ตรวจสอบการอ่านค่าเซนเซอร์ (DEBUG SENSOR)
  //    * ปลดคอมเมนต์เพื่อเช็คว่าเซนเซอร์อ่านค่าได้จริงหรือไม่ก่อนแข่ง *
  //    * เมื่อจะลงแข่งจริง ให้ใส่ // คอมเมนต์ปิดไว้ *
  // ==========================================================================
  // ShowSensor();  // แสดงค่า ADC ดิบ 16 ช่อง (0..4095) บน Serial Monitor
  // ShowLine();    // แสดงค่า Calibrated (0..1000) และตำแหน่งเส้นจริง (-100..+100%)

  // ==========================================================================
  // 5. โหมดรอการออกตัว (START / CALIBRATION)
  //    - กด SW1 = หมุนตัว Calibrate แสงขาว/ดำ และบันทึกลง EEPROM อัตโนมัติ
  //    - กด SW2 = ออกตัวเริ่มวิ่งภารกิจ
  // ==========================================================================
  waitForStart();
  LedGreen();

  // ==========================================================================
  // 6. ลำดับภารกิจ (MISSION SEQUENCE) - เลือกเปิดใช้งานรูปแบบ PD ตามด่านสนาม
  //    รูปแบบ Action:
  //      's' = หยุดทันทีที่เจอแยก (Stop)
  //      'l' = เลี้ยวซ้าย 90 องศาและจับเส้นใหม่ (Turn Left)
  //      'r' = เลี้ยวขวา 90 องศาและจับเส้นใหม่ (Turn Right)
  //      'p' = วิ่งข้ามเส้นตัดไปตรงๆ แล้วหยุด (Pass Cross)
  // ==========================================================================

  // --- [Step 1] วิ่งออกตัวนุ่มนวลตามเวลา (Soft Start) ---
  //        Speed%   Kp    Kd   Time(ms)
  PD_Time(   55,    1.2,  14,   1200   );

  // --- [Step 2] วิ่งทางตรงยาวด้วยความเร็วสูงตามเวลา (Fast Straight) ---
  // PD_Time( 75,    1.5,  22,   2500   );

  // --- [Step 3] วิ่งไปจนเจอทางแยกซ้าย (ริมซ้ายเจอตัวเดียว) แล้วเลี้ยวซ้าย 90 องศา ---
  // PD_Left(  60,    1.3,  16,   'l'    );

  // --- [Step 4] วิ่งไปจนเจอทางแยกขวา (ริมขวาเจอตัวเดียว) แล้วเลี้ยวขวา 90 องศา ---
  // PD_Right( 60,    1.3,  16,   'r'    );

  // --- [Step 5] วิ่งข้ามทางแยกตัดรูปบวก (+) ตรงไปข้างหน้าโดยไม่เลี้ยว ---
  // PD_Cross( 60,    1.3,  16,   'p'    );

  // --- [Step 6] วิ่งไปจนเจอเส้นตัด/แยก แล้วเลี้ยวซ้าย 90 องศา ---
  // PD_Cross( 60,    1.3,  16,   'l'    );

  // --- [Step 7] วิ่งไปจนเจอเส้นตัด/แยก แล้วเลี้ยวขวา 90 องศา ---
  // PD_Cross( 60,    1.3,  16,   'r'    );

  // --- [Step 8] สั่งหมุนตัวเลี้ยว 90 องศาแบบเดี่ยวๆ (กรณีหยุดอยู่แล้วจะเลี้ยว) ---
  // turnLeft();
  // turnRight();

  // --- [Step 9] ขับมอเตอร์ตรงตามเวลา (เช่น ดันกระป๋อง / หลบสิ่งกีดขวาง) ---
  // Motor(60, 60); delay(300); Stop();

  // --- [Finish] เข้าเส้นชัยสุดท้าย (เจอเส้นตัดแล้วเบรกหยุดสนิท) ---
  PD_Cross(  60,    1.3,  16,   's'    );

  // ==========================================================================
  // จบภารกิจใน setup()
  // ==========================================================================
  Stop();
  blinkLed(0, 255, 0, 5, 120);  // กระพริบไฟเขียวฉลองจบภารกิจ
}

void loop() {
  // เมื่อจบภารกิจใน setup() แล้ว ให้เบรกหยุดมอเตอร์ตลอดเวลาใน loop
  Stop();
}
